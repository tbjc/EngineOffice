  <ItemGroup>
    <ProjectReference Include="..\OfficeEngine.Word\OfficeEngine.Word.csproj" />
    <ProjectReference Include="..\OfficeEngine.Excel\OfficeEngine.Excel.csproj" />
  </ItemGroup>

</Project>
